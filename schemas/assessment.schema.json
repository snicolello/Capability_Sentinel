{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrm.local/schemas/assessment.schema.json",
  "title": "ARRM run assessment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "agent_id",
    "policy_id",
    "events_observed",
    "matched_policy",
    "capability_drift",
    "overall_decision",
    "evaluations",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "run_id": { "$ref": "event.schema.json#/$defs/id" },
    "agent_id": { "$ref": "event.schema.json#/$defs/id" },
    "policy_id": { "$ref": "event.schema.json#/$defs/id" },
    "events_observed": { "type": "integer", "minimum": 0 },
    "matched_policy": { "type": "integer", "minimum": 0 },
    "capability_drift": { "type": "integer", "minimum": 0 },
    "overall_decision": {
      "enum": ["ALLOW", "LOG", "REQUIRE_APPROVAL", "BLOCK", "TERMINATE"]
    },
    "evaluations": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/evaluation" }
    },
    "findings": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "finding.schema.json" }
    }
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "outcome", "decision"],
      "properties": {
        "event_id": { "$ref": "event.schema.json#/$defs/id" },
        "outcome": { "enum": ["ALLOWED", "DRIFT"] },
        "decision": {
          "enum": ["ALLOW", "LOG", "REQUIRE_APPROVAL", "BLOCK", "TERMINATE"]
        },
        "matched_rule_id": { "$ref": "event.schema.json#/$defs/id" },
        "finding_id": { "$ref": "event.schema.json#/$defs/id" }
      },
      "oneOf": [
        {
          "required": ["matched_rule_id"],
          "properties": {
            "outcome": { "const": "ALLOWED" },
            "decision": { "const": "ALLOW" },
            "matched_rule_id": {}
          },
          "not": {
            "properties": { "finding_id": {} },
            "required": ["finding_id"]
          }
        },
        {
          "required": ["finding_id"],
          "properties": {
            "outcome": { "const": "DRIFT" },
            "decision": {
              "enum": ["LOG", "REQUIRE_APPROVAL", "BLOCK", "TERMINATE"]
            },
            "finding_id": {}
          },
          "not": {
            "properties": { "matched_rule_id": {} },
            "required": ["matched_rule_id"]
          }
        }
      ]
    }
  }
}
